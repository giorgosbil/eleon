# Generated passwords are written to .env by start.sh / Start.ps1.
ECW_DB_PASSWORD=
ECW_DB_ROOT_PASSWORD=
ECW_SETUP_TOKEN=
# Branding for this installation only: eleon or original (penguin).
ECW_PRODUCT_BRAND=eleon
ECW_HTTP_PORT=8080
# 127.0.0.1 = this computer only. 0.0.0.0 = every device on the network (office server).
ECW_BIND_ADDRESS=127.0.0.1
# The address people open. Used in emailed links (password reset, invitations) — set it to
# the real one (e.g. https://192.168.2.10:8443 or https://cases.office.lan:8443).
ECW_BASE_URL=http://localhost:8080
# Backups (Settings → Backups, folder ./backups): one a day automatically, keep the newest 14.
ECW_BACKUPS=1
ECW_BACKUP_KEEP=14
# Optional HTTPS (scripts/https-setup.ps1 / .sh fills these in).
ECW_HTTPS_PORT=8443
ECW_HTTPS_HOSTS="localhost"
ECW_PROXY_SECRET=
ECW_GRAPH_CLIENT_ID=
ECW_GRAPH_CLIENT_SECRET=
ECW_GRAPH_REDIRECT_URI=http://localhost:8080/other_things/web/oauth/callback.php
# 1 = also personal Outlook.com / Hotmail / Live accounts. The Entra app registration must
# allow "Accounts in any organizational directory and personal Microsoft accounts".
ECW_GRAPH_PERSONAL_ACCOUNTS=0
# Gmail (optional). Redirect defaults to ECW_GRAPH_REDIRECT_URI: both providers use the same callback.
ECW_GOOGLE_CLIENT_ID=
ECW_GOOGLE_CLIENT_SECRET=
ECW_GOOGLE_REDIRECT_URI=http://localhost:8080/other_things/web/oauth/callback.php
# Built-in AI (Settings → Email assistant → Built in). Key from console.anthropic.com.
ECW_CLAUDE_API_KEY=
# Claude requests per workspace per day (a workspace can lower it, never raise it).
ECW_AI_DAILY_REQUESTS=20
# How many days a sign-in lasts without using the app (renewed with every use). Default 90.
#ECW_SESSION_DAYS=90

# Off-site backup copies (Settings -> Backups -> Off-site copy -> Folder): a NAS share or a cloud-synced folder.
# ECW_OFFSITE_DIR=D:/OneDrive/ECW-backups
# Memory for the database (default 512M). With many mailboxes or years of mail,
# give it about half the server's RAM, e.g. 2G. Settings -> System health warns when it is too small.
# ECW_DB_MEMORY=2G
# Update channel (Settings -> System health): where new versions are published.
# ECW_UPDATE_URL=https://updates.example.com/ecw/latest.json
